# Application
APP_URL=http://localhost:3000

# Application database. Use any PostgreSQL provider; `make dev` uses local PostgreSQL.
DATABASE_URL=postgresql://invook:invook@127.0.0.1:54322/invook

# Temporal Cloud. Create an API key for this namespace and use a unique task
# queue prefix for each environment so development workers cannot consume
# production tasks.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE_PREFIX=invook-local
GMAIL_CONTENT_CONCURRENCY=5
# Automatic Invook labeling uses individual calls for the last 14 days.
# OpenAI Batch is reserved for explicit historical label requests in settings.
MAIL_LABEL_CONCURRENCY=5
# Concurrent bulk activities (snapshot sync, historical derivations) per worker
# process. Each Workflow paces its own work, so this bounds the process, not a
# single user.
MAIL_BULK_CONCURRENCY=3

# Google Identity for Better Auth. This flow requests only openid, email, and
# profile. Register /v1/auth/callback/google as an authorized redirect URI.
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=

# Generate independently with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Gmail connection OAuth. Register /connections/gmail/callback as an authorized
# redirect URI. These values may match the Better Auth Google client values.
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
# Public HTTPS endpoint registered as the Pub/Sub push audience.
GOOGLE_PUBSUB_PUSH_AUDIENCE=
# Service account selected on the authenticated Pub/Sub push subscription.
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PUBSUB_SUBSCRIPTION=

# S3-compatible mailbox object storage. Docker Compose provides MinIO locally.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=invook-mail
S3_ACCESS_KEY_ID=invook
S3_SECRET_ACCESS_KEY=invook-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Thread label classification. One OpenAI endpoint serves both the live
# per-thread classifier and the historical label Batch.
OPENAI_API_KEY=
# Optional. Defaults to the OpenAI API. Set this only to route both live and
# Batch calls through a compatible gateway or proxy, and leave it commented out
# otherwise: @ai-sdk/openai builds a default provider at import time and rejects
# an empty OPENAI_BASE_URL, so exporting it blank fails the process at startup.
# OPENAI_BASE_URL=
# Verifies OpenAI Batch completion webhooks.
OPENAI_WEBHOOK_SECRET=
# Optional override for the model used by live per-thread classification.
# Defaults to gpt-5.6-luna, the same model the label Batch runs.
OPENAI_MODEL=
# Optional override for the OpenAI Responses Batch model used by Invook labels.
OPENAI_LABEL_BATCH_MODEL=gpt-5.6-luna
# Cap one serialized label Batch below the provider organization's total
# enqueued-token ceiling so foreground and unrelated Batch work retain capacity.
OPENAI_LABEL_BATCH_INPUT_TOKEN_LIMIT=500000
