# Application
APP_URL=http://localhost:3000

# Application database. Use any PostgreSQL provider; `make dev` uses local PostgreSQL.
DATABASE_URL=postgresql://invook:invook@127.0.0.1:54322/invook

# Temporal Cloud. Create an API key for this namespace and use a unique task
# queue prefix for each environment so development workers cannot consume
# production tasks.
TEMPORAL_ADDRESS=
TEMPORAL_NAMESPACE=
TEMPORAL_API_KEY=
TEMPORAL_TASK_QUEUE_PREFIX=invook-local
# Split tenants deterministically across worker groups. Replicas in the same
# group use the same count and index.
TEMPORAL_TENANT_SHARD_COUNT=1
TEMPORAL_TENANT_SHARD_INDEX=0
GMAIL_CONTENT_CONCURRENCY=5
MAIL_LABEL_CONCURRENCY=5
# Inbox threads active within this many days of a sync run's creation are
# labeled on the live lane during the initial import instead of waiting for an
# OpenAI Batch. Zero disables the hot window; the max bounds live calls per run.
MAIL_LABEL_HOT_WINDOW_DAYS=14
MAIL_LABEL_HOT_WINDOW_MAX_THREADS=1000
# Concurrent bulk activities (snapshot sync, historical derivations) per user.
# Keep above one so a user's Gmail accounts synchronize in parallel.
MAIL_BULK_CONCURRENCY=3

# Google Identity for Better Auth. This flow requests only openid, email, and
# profile. Register /v1/auth/callback/google as an authorized redirect URI.
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=

# Generate independently with: openssl rand -base64 32
BETTER_AUTH_SECRET=

# Gmail connection OAuth. Register /connections/gmail/callback as an authorized
# redirect URI. These values may match the Better Auth Google client values.
GMAIL_GOOGLE_CLIENT_ID=
GMAIL_GOOGLE_CLIENT_SECRET=
GMAIL_PUBSUB_TOPIC=
# Public HTTPS endpoint registered as the Pub/Sub push audience.
GOOGLE_PUBSUB_PUSH_AUDIENCE=
# Service account selected on the authenticated Pub/Sub push subscription.
GOOGLE_PUBSUB_PUSH_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PUBSUB_SUBSCRIPTION=

# S3-compatible mailbox object storage. Docker Compose provides MinIO locally.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=invook-mail
S3_ACCESS_KEY_ID=invook
S3_SECRET_ACCESS_KEY=invook-local-secret
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=

# Feedback learning and drafting.
# Point this at any OpenAI-compatible model endpoint.
# AI_API_KEY can stay empty for a local endpoint such as Ollama.
# When the app runs in Docker, use host.docker.internal instead of 127.0.0.1.
AI_BASE_URL=http://host.docker.internal:11434/v1
AI_API_KEY=
AI_MODEL=

# Initial and incremental Memory analysis use one native Batch provider.
# Supported values: openai or azure-openai.
MEMORY_BATCH_PROVIDER=

# OpenAI Batch
OPENAI_API_KEY=
OPENAI_WEBHOOK_SECRET=
# Optional override for the OpenAI Responses Batch model used by Invook labels.
OPENAI_LABEL_BATCH_MODEL=gpt-5.6-luna
# Cap one serialized label Batch below the provider organization's total
# enqueued-token ceiling so foreground and unrelated Batch work retain capacity.
OPENAI_LABEL_BATCH_INPUT_TOKEN_LIMIT=500000
# Azure OpenAI Batch. Use a Global-Batch or Data Zone Batch deployment.
AZURE_OPENAI_API_KEY=
# Resource root or the same URL ending in /openai/v1.
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_BATCH_DEPLOYMENT=
# Set this to the documented maximum input tokens for the deployed model.
AZURE_OPENAI_BATCH_INPUT_TOKEN_LIMIT=
AZURE_OPENAI_WEBHOOK_SECRET=
